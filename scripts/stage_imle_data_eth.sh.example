#!/bin/bash
set -euo pipefail

# Usage:
#   bash stage_imle_data_eth.sh                        # default settings
#   bash stage_imle_data_eth.sh --subset hotel --output_dir /tmp/out

# ── Paths (must match sample_fm_eth.sh) ──────────────────────────────────────
OUTPUT_DIR=/workspace/outputs/cor_fm/exp_01_FM_S10_log_m-0.5_s1.5_dire_drop_emb_m0.5_k20.0_IS_TN_NN_A_REG_S_eth_rot_6_min_max_LR0.0001_WD0.01_CLS_1.0_BS32_EP150
DATA_DIR=/workspace/project/data/eth_ucy

# ── Experiment ───────────────────────────────────────────────────────────────
SUBSET=eth

# ── Parse overrides (--KEY value) ────────────────────────────────────────────
while [[ $# -gt 0 ]]; do
    key="${1^^}"
    key="${key//-/_}"
    key="${key#_}"
    printf -v "$key" '%s' "$2"
    shift 2
done

# ─────────────────────────────────────────────────────────────────────────────
SRC_DIR="${OUTPUT_DIR}/samples"
DST_DIR="${DATA_DIR}/imle/${SUBSET}"

echo "Source : ${SRC_DIR}"
echo "Dest   : ${DST_DIR}"

[[ -d "$SRC_DIR" ]] || { echo "ERROR: source directory not found: ${SRC_DIR}"; exit 1; }

files=("${SRC_DIR}"/*train*.pkl)
[[ -e "${files[0]}" ]] || { echo "ERROR: no *train*.pkl files found in ${SRC_DIR}"; exit 1; }

mkdir -p "$DST_DIR"
cp "${files[@]}" "$DST_DIR/"

echo "Copied ${#files[@]} file(s) to ${DST_DIR}"
